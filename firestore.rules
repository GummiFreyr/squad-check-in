rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everyone in the app can see the squad's answers; each person only edits their own.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      // Someone who re-added the app may delete their old copy once their own entry says it replaces it.
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.get("replaces", "") == uid;
    }
    // Notification tokens: each person writes their own, nobody can read them
    // (the daily reminder job reads them with admin access).
    match /tokens/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
